# ============================================================================
# PetCare Passport - Environment Configuration Template
# ============================================================================

PORT=5000
NODE_ENV=development

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=petcare_passport

# Session Security Secret
SESSION_SECRET=your_super_secret_session_key_here_min_32_characters

# Base URL of the Application (used for generating absolute QR links)
# For local dev: http://localhost:5000
# For production: https://yourdomain.com
APP_URL=http://localhost:5000
